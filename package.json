{
  "name": "@killki/mock-fast",
  "version": "0.5.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Zero-config HTTP mock server with a small, scalable JSON DSL — nested routes, inherited auth, error injection, variable latency, per-user rate limiting, Faker templating, hot reload, and one-command Docker deploy. A lightweight json-server / Mockoon alternative.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "miguelkillki",
    "url": "https://miguelkillki.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiguelRoot/mock-fast.git"
  },
  "homepage": "https://github.com/MiguelRoot/mock-fast#readme",
  "bugs": {
    "url": "https://github.com/MiguelRoot/mock-fast/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mock-fast": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mock",
    "mock-server",
    "mock-api",
    "api-mocking",
    "http-mock",
    "fake-api",
    "rest-api",
    "stub",
    "fixtures",
    "api",
    "rest",
    "testing",
    "test-server",
    "contract-testing",
    "prototyping",
    "development",
    "dev-server",
    "dsl",
    "faker",
    "handlebars",
    "templating",
    "rate-limit",
    "error-injection",
    "latency",
    "auth",
    "cors",
    "express",
    "mocks-server",
    "json-server",
    "mockoon",
    "docker",
    "cli"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:ts": "tsc -p tsconfig.json",
    "build:skill": "node scripts/build-skills.mjs",
    "build": "npm run clean && npm run build:ts && npm run build:skill",
    "dev": "tsx src/cli.ts start",
    "start": "node ./dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "ship": "npm version patch && npm publish",
    "ship:minor": "npm version minor && npm publish",
    "ship:major": "npm version major && npm publish"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "@mocks-server/main": "^4.1.0",
    "handlebars": "^4.7.8",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
