{
  "server": { "port": 3001, "host": "127.0.0.1", "cors": true },
  "auth": { "headerName": "Authorization", "pattern": "^Bearer [A-Za-z0-9._-]+$" },
  "routes": [
    {
      "url": "/autenticacion-mobile-service/autenticacion",
      "method": "post",
      "extensions": {
        "rateLimit": {
          "identifier": "{{body.usuario}}",
          "window": "on-success",
          "max": 3,
          "onLimit": { "status": 423, "body": { "error": "Cuenta temporalmente bloqueada" } }
        }
      },
      "responses": [
        {
          "when": { "body.usuario": "jperez", "body.contrasena": "test1234", "body.totp": null },
          "status": 200,
          "body": {
            "code": 200,
            "status": "success",
            "data": {
              "usuario": {
                "username": "jperez",
                "nombres": "JUAN",
                "apellidos": "PEREZ LOPEZ",
                "email": "jperez@example.com",
                "fecRegistro": null,
                "codEmpleado": "12345",
                "codCostcenter": "0000002280",
                "desCostcenter": "AREA DE INGENIERIA DE SOFTWARE",
                "roles": null
              },
              "aplicaciones": null
            },
            "timestamp": "{{now}}"
          }
        },
        {
          "when": { "body.usuario": "jperez", "body.contrasena": "test1234", "body.totp": "123456" },
          "status": 200,
          "body": {
            "code": 200,
            "status": "success",
            "data": {
              "usuario": {
                "username": "jperez",
                "nombres": "JUAN",
                "apellidos": "PEREZ LOPEZ",
                "email": "jperez@example.com",
                "fecRegistro": null,
                "codEmpleado": "12345",
                "codCostcenter": "0000002280",
                "desCostcenter": "AREA DE INGENIERIA DE SOFTWARE",
                "roles": null
              },
              "aplicaciones": [
                {
                  "codigo": "VS",
                  "token": "Bearer mock.{{uuid}}",
                  "perfiles": ["Administrador del sistema"],
                  "perfilesDetails": null,
                  "acciones": [
                    "G1_00_00_LI",
                    "G1_01_00_LI",
                    "G1_01_01_CR",
                    "G1_01_02_VE",
                    "G1_01_03_EL",
                    "G1_02_00_LI",
                    "G1_02_01_CR",
                    "G1_03_00_LI",
                    "G1_03_01_CR"
                  ]
                }
              ]
            },
            "timestamp": "{{now}}"
          }
        },
        {
          "status": 401,
          "body": {
            "code": 401,
            "status": "error",
            "message": "Credenciales inválidas",
            "timestamp": "{{now}}"
          }
        }
      ]
    },

    {
      "url": "/api",
      "routes": [
        {
          "url": "/estado",
          "method": "get",
          "extensions": { "delayRange": [50, 200] },
          "response": {
            "status": 200,
            "body": { "status": "ok", "version": "1.0.0", "ts": "{{now}}" }
          }
        },

        {
          "url": "/protegida",
          "extensions": { "requireAuth": true, "errorRate": 0.05, "delayRange": [100, 400] },
          "routes": [
            {
              "url": "/perfil",
              "method": "get",
              "response": {
                "status": 200,
                "body": {
                  "code": 200,
                  "data": {
                    "username": "jperez",
                    "nombres": "JUAN",
                    "sessionId": "{{uuid}}",
                    "roles": ["admin"]
                  },
                  "timestamp": "{{now}}"
                }
              }
            },
            {
              "url": "/pricing",
              "method": "get",
              "extensions": { "requireAuth": false },
              "response": {
                "status": 200,
                "body": { "free": 0, "pro": 9.99, "enterprise": null }
              }
            },
            {
              "url": "/usuarios",
              "method": "get",
              "response": {
                "status": 200,
                "body": { "data": [ { "id": 1, "nombre": "Juan" }, { "id": 2, "nombre": "Ana" } ] }
              },
              "routes": [
                {
                  "url": "/:id",
                  "method": "get",
                  "responses": [
                    {
                      "when": { "params.id": "1" },
                      "status": 200,
                      "body": { "id": 1, "nombre": "Juan", "email": "jperez@example.com" }
                    },
                    {
                      "status": 404,
                      "body": { "code": 404, "error": "Usuario no encontrado" }
                    }
                  ]
                }
              ]
            },
            {
              "url": "/archivos/*",
              "method": "get",
              "response": {
                "status": 200,
                "body": {
                  "ruta": "{{params.[0]}}",
                  "url": "https://cdn.example.com/{{params.[0]}}"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
